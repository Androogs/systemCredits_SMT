# --- API / frontend ---
APP_TITLE=Creditos API - Inversiones Pacifico
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_HOST=0.0.0.0
API_PORT=8000
# URL pública del frontend: la codifica el QR de verificación de firma
# en los documentos de legalización (en producción, el dominio real).
APP_URL_PUBLICA=http://localhost:5173
LOG_LEVEL=INFO
# 'json' (defecto): una línea-documento por evento, consultable con jq.
# 'texto': formato plano legible para desarrollo.
LOG_FORMAT=json
DEMO_USER_EMAIL=demo@sumoto.com.co
DEMO_USER_PASSWORD=demo1234

# --- Motor ---
ENVIRONMENT=demo            # demo | produccion
SMMLV=1750905
PARAMETROS_PATH=parametros.json

# --- Base de datos ---
# PostgreSQL (esquema SUMOTO): postgresql+psycopg://user:pass@host:5432/db
# Desarrollo / pruebas:        sqlite:///./motor_decision.db
DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/DB
DB_CREAR_TABLAS=false       # schema lo manejan schema.sql + alembic

# --- DataCrédito Experian ---
OKTA_TOKEN_URL_DEMO=
OKTA_TOKEN_URL_PROD=
HDC_TOKEN_URL_DEMO=
HDC_TOKEN_URL_PROD=
HDC_BASE_URL_DEMO=
HDC_BASE_URL_PROD=
HDC_USERNAME=
HDC_PASSWORD=
HDC_TOKEN_USERNAME=
HDC_TOKEN_PASSWORD=
HDC_CLIENT_ID=
HDC_CLIENT_SECRET=
HDC_PRODUCT_ID=64
SERVER_IP_ADDRESS=
INCOME_USERNAME=
INCOME_PASSWORD=
INCOME_CLIENT_ID=
INCOME_CLIENT_SECRET=
INCOME_SCOPE=expco_incomes
INCOME_BASE_URL_DEMO=
INCOME_BASE_URL_PROD=
INCOME_SUBSCRIBER_NAME=
INCOME_TOKEN_URL_DEMO=
INCOME_TOKEN_URL_PROD=
TIMEOUT_EXPERIAN_SEGUNDOS=60

# --- Pre-filtro SIMIT (multas de tránsito, vía PlacaPi) ---
# Corre antes de la consulta de buró: con deuda SIMIT pendiente la
# evaluación rechaza (R22) sin gastar la llamada a Experian.
# Sin API key el pre-filtro se omite en línea (en demo responde mock).
SIMIT_HABILITADO=true
# Proveedor: "placapi" (hoy). Con el convenio de consulta masiva FCM: "fcm".
SIMIT_PROVEEDOR=placapi
SIMIT_BASE_URL=https://placapi.com
SIMIT_API_KEY=
SIMIT_TIMEOUT_SEGUNDOS=15
# true: si SIMIT no responde la evaluación se bloquea; false: sigue sin pre-filtro.
SIMIT_REQUERIDO=false

# --- Reuso de consulta a centrales (consulta_buro) ---
# La consulta a Experian se paga una vez por persona: si el reporte
# sigue vigente, la re-evaluación corre el motor con esos datos.
BURO_CACHE_HABILITADO=true
# Días de vigencia del reporte guardado. 0 = siempre consulta en línea.
BURO_CACHE_DIAS=30

# --- Webhook de confirmación de desembolso (POST /webhook/desembolso) ---
# Secreto compartido HMAC-SHA256 con el emisor del giro (tesorería/core
# bancario). VACÍO = endpoint deshabilitado (responde 503).
WEBHOOK_SECRETO=
# Ventana anti-replay en segundos para el header X-Timestamp.
WEBHOOK_VENTANA_SEGUNDOS=300

# --- Captura remota de evidencias (cédula + video) ---
# Directorio local donde se guardan las evidencias (MVP; en producción: S3)
EVIDENCIAS_DIR=uploads/evidencias
# Vigencia del link/QR que recibe el cliente (minutos)
CAPTURA_TTL_MINUTOS=30
# Tamaño máximo por archivo subido (MB)
EVIDENCIA_MAX_MB=25

# --- OCR de la cédula (Tesseract) ---
# Ruta al binario de Tesseract si NO está en el PATH. Vacío = usar el PATH.
# En Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Carpeta con los .traineddata cuando no están junto al binario
# (ej. Windows sin permisos de escritura en Program Files). Vacío = default.
TESSDATA_DIR=
# Idioma(s) del OCR. Debe incluir 'spa' (instalar el paquete de idioma).
TESSERACT_LANG=spa

# --- Notificaciones al cliente y OTP ---
# Email por SMTP estándar (funciona con cuentas gratuitas; sin estos
# valores las notificaciones se registran en log y el OTP se muestra
# en pantalla en modo demo). SMS requiere proveedor pago.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_DESDE=
SMTP_TLS=true
# WhatsApp vía WATI (canal primario del OTP; sin credenciales queda
# simulado en log y con teléfono inválido/ausente cae a email).
# Requiere una plantilla de autenticación aprobada por Meta en el
# dashboard de WATI (planes Growth/Pro/Business).
WATI_BASE_URL=
WATI_TENANT_ID=
WATI_API_TOKEN=
WATI_CHANNEL_NUMBER=        # solo tenants con varias WABA
WATI_PLANTILLA_OTP=otp_verificacion
WATI_TIMEOUT_SEGUNDOS=15
# Twilio: OTP por SMS via Verify API (canal primario tras descartar WATI)
# y mensajes directos. Verify genera/expira el codigo y maneja reintentos.
TWILIO_ACCOUNT_SID=         # ACxxxx
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=          # VAxxxx — console > Verify > Services
TWILIO_FROM_NUMBER=         # +57... para SMS directos
TWILIO_MESSAGING_SERVICE_SID= # MGxxxx (alternativa al numero)
# Vigencia del código OTP (minutos) y máximo de intentos fallidos
OTP_TTL_MINUTOS=10
OTP_MAX_INTENTOS=3
# Días de vigencia de una oferta generada; vencida no es seleccionable
OFERTA_VIGENCIA_DIAS=15

# --- Autenticacion JWT de la plataforma ---
# Secreto de firma HS256. Obligatorio fuera de demo: sin el el login
# responde 503. En demo cae a un valor de desarrollo si se deja vacio.
JWT_SECRETO=
# Vigencia del token en horas (jornada laboral)
JWT_TTL_HORAS=8
# Lockout de login: N fallos seguidos -> bloqueo temporal
AUTH_MAX_INTENTOS=5
AUTH_BLOQUEO_MINUTOS=15
# Roles con acceso al panel (cliente/contabilidad quedan fuera)
AUTH_ROLES_PANEL=admin,concesionario,asesor,aliado
