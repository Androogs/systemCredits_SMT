# Vacío = llamadas relativas a /api (proxy de Vite en dev). En producción,
# URL absoluta de la API publicada (ej. https://api.ejemplo.com).
VITE_API_URL=
# Debe apuntar al puerto del backend local (README: uvicorn en 8000).
# Si apunta a un puerto sin backend, Vite responde 502 + toast "Sin respuesta".
API_PROXY_TARGET=http://127.0.0.1:8000
