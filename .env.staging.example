# Ambiente de pruebas — docker-compose.staging.yml
# Copiar a .env.staging y ajustar las claves antes de levantar.

# Base de datos (contenedor postgres:16-alpine interno del stack)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=creditos_qa

# Login del ambiente (ENVIRONMENT=demo → estas son las credenciales)
DEMO_USER_EMAIL=qa@sumoto.com.co
DEMO_USER_PASSWORD=cambia-esta-clave

# Puerto donde queda expuesto todo el stack (web + /api)
STAGING_PORT=8080

# URL pública si se comparte por dominio/túnel (informativa para CORS;
# el frontend va por el mismo origen a través de nginx)
PUBLIC_URL=http://localhost:8080

# Rate limit relajado: detrás de nginx todas las peticiones comparten la
# IP interna del proxy; 300 mutadores/min evita frenar a los testers.
RATE_LIMIT_MAX_PETICIONES=300

SMMLV=1750905
LOG_LEVEL=INFO

# --- Pre-filtro SIMIT (PlacaPi) ---
# Sin API key el pre-filtro se omite y la evaluación sigue sin él.
SIMIT_HABILITADO=true
SIMIT_PROVEEDOR=placapi
SIMIT_BASE_URL=https://placapi.com
SIMIT_API_KEY=
SIMIT_REQUERIDO=false

# --- Webhook de desembolso (POST /webhook/desembolso) ---
# Secreto compartido con el emisor del giro en QA. VACÍO = endpoint
# deshabilitado (503): para probar el ciclo asíncrono hay que fijar uno.
WEBHOOK_SECRETO=
WEBHOOK_VENTANA_SEGUNDOS=300

# --- Autenticacion JWT (obligatorio fuera de demo) ---
JWT_SECRETO=
JWT_TTL_HORAS=8
AUTH_MAX_INTENTOS=5
AUTH_BLOQUEO_MINUTOS=15
AUTH_ROLES_PANEL=admin,concesionario,asesor,aliado
