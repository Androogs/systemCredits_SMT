# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
**/.venv/
**/__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
.coverage
.coverage.*
htmlcov/
coverage.xml

